# ── Priceless Bundle — environment ───────────────────────────
# Copy to .env.local and fill in. Never commit real secrets.

# Supabase Postgres connection string (required)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Signs login cookies — use a long random string (required)
SESSION_SECRET=change-me-to-a-long-random-string

# Shared PIN that unlocks /admin (required)
ADMIN_PIN=2468

# Shared secret for the SMS webhook (required) — the Android SMS-forwarder
# sends this as the X-Webhook-Secret header
SMS_WEBHOOK_SECRET=change-me-too

# DataMartGH API key. Leave EMPTY to run in simulated mode (~95% success)
# so the app works end-to-end before a live key is added.
DATAMART_API_KEY=

# MoMo / Telecel Cash collection number shown to customers (optional)
MOMO_COLLECTION_NUMBER=059 882 3601

# DataMartGH base URL (optional)
DATAMART_BASE_URL=https://api.datamartgh.shop/api
